# Data source switch. Mocks are ON unless this is exactly "false" (shared/lib/config.ts).
NEXT_PUBLIC_USE_MOCKS=true

# Origin of the Socket.IO gateway of telemetry (reverse proxy, path /ws). Default: http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080

# Server-side target of the /api/v1 rewrite in next.config.ts. Default: http://localhost:8080
BACKEND_URL=http://localhost:8080