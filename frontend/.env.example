# Data source switch. Mocks are ON unless this is exactly "false" (shared/lib/config.ts).
NEXT_PUBLIC_USE_MOCKS=true

# Origin of the Socket.IO gateway of telemetry (reverse proxy, path /ws). Default: http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:8080

# Server-side target of the /api/v1 rewrite in next.config.ts. Default: http://localhost:8080
BACKEND_URL=http://localhost:8080

# Split deploy (Vercel + Render + Koyeb): separate hosts for the two rewrites (build time, no trailing slash needed).
# /api/v1/telemetry/* goes to TELEMETRY_URL, the rest of /api/v1/* to CORE_URL. Each falls back to BACKEND_URL when unset.
# CORE_URL=https://<core>.onrender.com
# TELEMETRY_URL=https://<app>.koyeb.app
# The Tower socket cannot go through the rewrites; point it straight at telemetry:
# NEXT_PUBLIC_WS_URL=https://<app>.koyeb.app
