FROM node:22-alpine

WORKDIR /usr/src/app

RUN npm install -g pnpm@11.5.2

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# The pnpm store lives in a BuildKit cache, so a retried build reuses what was already downloaded
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

COPY . .

# The Prisma Clients are generated code (src/<module>/prisma/generated, gitignored): build them before nest build
RUN pnpm run prisma:auth:generate && pnpm run prisma:organization:generate

EXPOSE 3000

CMD ["pnpm", "run", "start:dev"]
