FROM node:22-alpine

WORKDIR /usr/src/app

RUN npm install -g pnpm@11.5.2

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

# The Prisma Clients are generated code (src/<module>/prisma/generated, gitignored): build them before nest build
RUN pnpm run prisma:auth:generate && pnpm run prisma:organization:generate

EXPOSE 3000

CMD ["pnpm", "run", "start:dev"]
