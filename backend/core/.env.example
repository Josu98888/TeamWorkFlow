PORT=3000

NATS_SERVER="nats://localhost:4222"

AUTH_DATABASE_URL=postgresql://auth_svc:change-me@localhost:5432/teamworkflow?schema=auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

ORGANIZATION_DATABASE_URL=postgresql://organization_svc:<password>@localhost:5432/teamworkflow?schema=organization

BILLING_DATABASE_URL=postgresql://billing_svc:<password>@localhost:5432/teamworkflow?schema=billing
PAYMENT_PROVIDER=fake
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
BILLING_TZ=America/Argentina/Buenos_Aires
VAT_PERCENT=21
TRIAL_DAYS=14
DUE_DAYS=10
GRACE_DAYS=7
DATA_RETENTION_DAYS=90
APP_URL=http://localhost:3002

TASKS_DATABASE_URL=postgresql://tasks_svc:<password>@localhost:5432/teamworkflow?schema=tasks
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=teamworkflow-tasks
S3_ACCESS_KEY=local-s3-access
S3_SECRET_KEY=local-s3-secret-key
S3_FORCE_PATH_STYLE=true
MEDIA_URL_TTL_SECONDS=300

NOTIFICATIONS_DATABASE_URL=postgresql://notifications_svc:<password>@localhost:5432/teamworkflow?schema=notifications
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# Secure flag for auth cookies. Default true in every environment (not tied to NODE_ENV).
# Browsers accept Secure cookies on http://localhost, so keep true locally.
# Set false ONLY for an HTTP-only test deployment, never with real users.
COOKIE_SECURE=true

# Optional. Full content of a NATS `.creds` file (Synadia Cloud). Leave unset for a local or self-hosted NATS.
# Multi-line values work on platforms that accept them; otherwise write each line break as a literal \n.
# NATS_CREDS=

# Postgres pool and TLS (defaults: pool 10, no TLS). Supabase: DB_POOL_MAX=3, DB_SSL=true and its CA in DB_SSL_CA.
# DB_POOL_MAX=3
# DB_SSL=true
# DB_SSL_CA=

# Optional separate URLs for `prisma migrate deploy` (for example the Supabase session pooler).
# MIGRATE_AUTH_DATABASE_URL=
# MIGRATE_ORGANIZATION_DATABASE_URL=
# MIGRATE_BILLING_DATABASE_URL=
# MIGRATE_TASKS_DATABASE_URL=
# MIGRATE_NOTIFICATIONS_DATABASE_URL=