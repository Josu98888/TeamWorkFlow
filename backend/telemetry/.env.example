# Telemetry Service Environment Variables
PORT=3003
NATS_SERVER=nats://localhost:4222
ATTENDANCE_DATABASE_URL=postgresql://attendance_svc:password@localhost:5432/teamworkflow?schema=attendance
WEB_ORIGIN=http://localhost:3000
NATS_TIMEOUT_MS=5000
RATE_LIMIT_AUTH_TTL_MS=60000
RATE_LIMIT_AUTH_LIMIT=100
JWT_SECRET=change-me-in-production-at-least-16-chars
AUTH_CACHE_TTL_MS=5000

# Optional. Full content of a NATS `.creds` file (Synadia Cloud). Leave unset for a local or self-hosted NATS.
# Multi-line values work on platforms that accept them; otherwise write each line break as a literal \n.
# NATS_CREDS=

# Postgres pool and TLS (defaults: pool 10, no TLS). Supabase: DB_POOL_MAX=5, DB_SSL=true and its CA in DB_SSL_CA.
# DB_POOL_MAX=5
# DB_SSL=true
# DB_SSL_CA=

# Optional separate URL for `prisma migrate deploy` (for example the Supabase session pooler).
# MIGRATE_ATTENDANCE_DATABASE_URL=
