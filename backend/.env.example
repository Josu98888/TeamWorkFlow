# PostgreSQL superuser (used only by the postgres container and the init script)
POSTGRES_PASSWORD=change-me

# Per-role passwords; backend/postgres/init creates one role per schema
AUTH_DB_PASSWORD=change-me
ORGANIZATION_DB_PASSWORD=change-me
TASKS_DB_PASSWORD=change-me
NOTIFICATIONS_DB_PASSWORD=change-me
BILLING_DB_PASSWORD=change-me
ATTENDANCE_DB_PASSWORD=change-me

# Legacy backend/auth app reads this until backend/core exists (T6)
DATABASE_URL=postgresql://auth_svc:change-me@localhost:5432/teamworkflow?schema=auth

# Per-owner connection strings (core modules + telemetry)
AUTH_DATABASE_URL=postgresql://auth_svc:change-me@localhost:5432/teamworkflow?schema=auth
ORGANIZATION_DATABASE_URL=postgresql://organization_svc:change-me@localhost:5432/teamworkflow?schema=organization
TASKS_DATABASE_URL=postgresql://tasks_seamworkflow?schema=tasks
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_svc:change-me@localhost:5432/teamworkflow?schema=notifications
BILLING_DATABASE_URL=postgresql://billi32/teamworkflow?schema=billing
ATTENDANCE_DATABASE_URL=postgresql://attendance_svc:change-me@localhost:5432/teamworkflow?schema=attendance

# Auth (min 32 chars); token TTLs default to 15m / 7d
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d 