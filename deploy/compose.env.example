# Copy to deploy/.env (git-ignored): `cp compose.env.example .env`.
# Read by `docker compose` for variable substitution in the compose files. Placeholders only.

# GitHub owner (user or organization) of the GHCR images, lowercase: ghcr.io/<GHCR_OWNER>/teamworkflow-<app>
GHCR_OWNER=your-github-owner
# Image tag to run: a commit SHA, a release tag or `latest`.
IMAGE_TAG=latest

# Enable TLS once a certificate exists (see README.md, "Enable TLS"):
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.tls.yml
# COMPOSE_PROFILES=tls

# Only for `--profile local-db` (a throwaway PostgreSQL on the same host). Empty values use local defaults.
# These must match the passwords inside the DATABASE_URLs of env/core.env and env/telemetry.env.
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
ORGANIZATION_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
TASKS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=
BILLING_DB_PASSWORD=
