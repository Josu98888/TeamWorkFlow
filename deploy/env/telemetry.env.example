# Copy to deploy/env/telemetry.env (git-ignored). Placeholders only: never commit real values.
# Used by the `telemetry` and `telemetry-migrate` services.

PORT=3003
NATS_SERVER=nats://nats:4222

# Optional. Full content of a NATS `.creds` file (Synadia Cloud). Leave unset for a local or self-hosted NATS.
# Multi-line values work on platforms that accept them; otherwise write each line break as a literal \n.
# NATS_CREDS=

# RDS requires TLS: keep sslmode=require. `--profile local-db`: host `postgres`, no sslmode,
# for example postgresql://attendance_svc:local-attendance@postgres:5432/teamworkflow?schema=attendance
ATTENDANCE_DATABASE_URL=postgresql://attendance_svc:CHANGE_ME@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/teamworkflow?schema=attendance&sslmode=require

# Supabase (free tier): schema `tw_attendance`, created by backend/postgres/supabase/01-schemas-and-roles.sql.
# SESSION pooler (port 5432), user `<role>.<projectref>`, URL-encoded password. Do not put `sslmode`
# in the URL: use DB_SSL below (pg gives the URL precedence over the ssl option).
# ATTENDANCE_DATABASE_URL=postgresql://tw_attendance_svc.<projectref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=tw_attendance
# Connections of the Prisma client. Default 10.
# DB_POOL_MAX=5
# Encrypt the connection. Without DB_SSL_CA it is encrypted but NOT verified; set DB_SSL_CA to the
# PEM of Supabase's CA (Project Settings > Database > SSL certificate) to verify the server.
# DB_SSL=true
# DB_SSL_CA=
# Optional: migrations use this instead of ATTENDANCE_DATABASE_URL (for example the direct connection).
# MIGRATE_ATTENDANCE_DATABASE_URL=

# Exact browser origin of the web app: CORS and the Socket.IO origin allow only this value.
# http://<host> in the plain-HTTP phase (no trailing slash, no port 80), https://<domain> after TLS.
WEB_ORIGIN=http://CHANGE_ME

# Optional tuning (defaults shown in backend/telemetry/src/config/env.schema.ts):
# NATS_TIMEOUT_MS=5000
# RATE_LIMIT_AUTH_TTL_MS=60000
# RATE_LIMIT_AUTH_LIMIT=100
# AUTH_CACHE_TTL_MS=5000
