# Copy to deploy/env/core.env (git-ignored). Placeholders only: never commit real values.
# Used by the `core` and `core-migrate` services.

NODE_ENV=production

# HTTP test phase ONLY (infrastructure checks, never real users). Browsers drop Secure cookies over
# http://, so login would never stick. Remove this line (default true) or set it to true as soon as
# TLS is enabled. See deploy/README.md, "HTTP versus HTTPS".
COOKIE_SECURE=false

PORT=3000
NATS_SERVER=nats://nats:4222

# Optional. Full content of a NATS `.creds` file (Synadia Cloud). Leave unset for a local or self-hosted NATS.
# Multi-line values work on platforms that accept them; otherwise use literal 
 for line breaks.
# NATS_CREDS=

# One role and one schema per module, created by backend/postgres/init (deploy/README.md, "Initialize RDS").
# RDS requires TLS: keep sslmode=require. URL-encode special characters in passwords.
AUTH_DATABASE_URL=postgresql://auth_svc:CHANGE_ME@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/teamworkflow?schema=auth&sslmode=require
ORGANIZATION_DATABASE_URL=postgresql://organization_svc:CHANGE_ME@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/teamworkflow?schema=organization&sslmode=require
BILLING_DATABASE_URL=postgresql://billing_svc:CHANGE_ME@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/teamworkflow?schema=billing&sslmode=require
TASKS_DATABASE_URL=postgresql://tasks_svc:CHANGE_ME@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/teamworkflow?schema=tasks&sslmode=require
NOTIFICATIONS_DATABASE_URL=postgresql://notifications_svc:CHANGE_ME@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/teamworkflow?schema=notifications&sslmode=require
# `--profile local-db` try-out: host `postgres`, no sslmode, passwords from deploy/.env, for example
# AUTH_DATABASE_URL=postgresql://auth_svc:local-auth@postgres:5432/teamworkflow?schema=auth

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Public origin of the web app (billing return links). Example: http://203.0.113.10 now, https://app.example.com later.
APP_URL=http://CHANGE_ME

# S3 for task media. On EC2 leave S3_ENDPOINT, S3_ACCESS_KEY and S3_SECRET_KEY unset/empty:
# the SDK uses the instance IAM role. S3_FORCE_PATH_STYLE stays false on AWS.
S3_REGION=us-east-1
S3_BUCKET=your-teamworkflow-tasks-bucket
S3_FORCE_PATH_STYLE=false
MEDIA_URL_TTL_SECONDS=300
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Push notifications (FCM). When enabled, project id and credentials (path or base64 JSON) are required.
FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_CREDENTIALS=

# Billing. `fake` needs no credentials; `mercadopago` needs both secrets and a public HTTPS webhook URL.
PAYMENT_PROVIDER=fake
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# Optional tuning (defaults shown in backend/core/src/config/env.schema.ts):
# BILLING_TZ=America/Argentina/Buenos_Aires
# VAT_PERCENT=21
# TRIAL_DAYS=14
# DUE_DAYS=10
# GRACE_DAYS=7
# DATA_RETENTION_DAYS=90
